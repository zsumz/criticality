#!/usr/bin/env bash
# Check repository boundaries that do not require compiling Rust.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
status=0

if [[ -e "$repo_root/scripts/check" || -L "$repo_root/scripts/check" ]]; then
    echo "error: zcheck.toml replaces the legacy scripts/check dispatcher" >&2
    status=1
fi

if [[ ! -f "$repo_root/zcheck.toml" ]]; then
    echo "error: canonical qualification manifest is missing: zcheck.toml" >&2
    status=1
fi

for removed in crates reference; do
    if [[ -e "$repo_root/$removed" || -L "$repo_root/$removed" ]]; then
        echo "error: single-crate repository may not contain $removed/" >&2
        status=1
    fi
done

while IFS= read -r markdown; do
    case "$markdown" in
        README.md | docs/concepts.md | docs/qualification.md) ;;
        *)
            echo "error: Markdown document is outside the reviewed set: $markdown" >&2
            status=1
            ;;
    esac
done < <(
    git -C "$repo_root" ls-files --cached --others --exclude-standard '*.md' \
        | LC_ALL=C sort
)

while IFS= read -r source; do
    lines="$(wc -l < "$source" | tr -d ' ')"
    if ((lines > 300)); then
        echo "error: Rust source exceeds 300 lines: ${source#"$repo_root"/} ($lines)" >&2
        status=1
    fi
done < <(find "$repo_root/src" "$repo_root/tests" -type f -name '*.rs' -print | LC_ALL=C sort)

if grep -R -F '#[cfg(test)]' "$repo_root/src" >/dev/null; then
    echo "error: tests belong in sibling *_test.rs files or tests/" >&2
    status=1
fi

if [[ -e "$repo_root/src/retained.rs" || -L "$repo_root/src/retained.rs" ]]; then
    echo "error: bytebudget replaces the local src/retained.rs authority" >&2
    status=1
fi

if grep -R -F 'RetainedBytes' "$repo_root/src" "$repo_root/README.md" >/dev/null; then
    echo "error: bytebudget migration may not retain a RetainedBytes authority or alias" >&2
    status=1
fi

for cargo_config in .cargo/config .cargo/config.toml; do
    if [[ -e "$repo_root/$cargo_config" || -L "$repo_root/$cargo_config" ]]; then
        echo "error: repository-local Cargo configuration is not permitted: $cargo_config" >&2
        status=1
    fi
done

if ((status != 0)); then
    exit "$status"
fi

echo "repository structure check passed"
