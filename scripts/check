#!/usr/bin/env bash
# Run the complete local repository qualification gate.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

git_state_before="$(git status --porcelain=v1 --untracked-files=all)"

zrail_bin="${ZRAIL:-zrail}"
if ! command -v "$zrail_bin" >/dev/null 2>&1 && [[ ! -x "$zrail_bin" ]]; then
    echo "error: zrail 0.0.2 is required" >&2
    exit 127
fi
if [[ "$("$zrail_bin" --version)" != "zrail 0.0.2" ]]; then
    echo "error: expected zrail 0.0.2 from the reviewed repository revision" >&2
    exit 1
fi

scripts/structure-check
cargo fmt --all -- --check
cargo check --lib --locked --offline
cargo clippy --all-targets --all-features --locked --offline -- -D warnings
cargo test --all-features --locked --offline
RUSTDOCFLAGS="-D warnings" cargo doc --all-features --no-deps --locked --offline
cargo package --locked --offline --allow-dirty
"$zrail_bin" check
git diff --check
git diff --cached --check

git_state_after="$(git status --porcelain=v1 --untracked-files=all)"
if [[ "$git_state_before" != "$git_state_after" ]]; then
    echo "error: scripts/check changed Git status" >&2
    git status --short --untracked-files=all >&2
    exit 1
fi

echo "criticality repository check passed"
